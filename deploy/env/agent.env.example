# WireServe agent configuration.
#
# Install at /etc/wireserve/agent.env. Read by both the systemd unit and
# the Quadlet unit.
#
# There is no coordinator URL or token here: the agent learns both during
# `wireserve-agent join`, which writes them to its own mode-600 state
# file along with the WireGuard private key. Nothing secret belongs in
# this file.
#
# The mesh address range is a coordinator-side setting — the agent is
# told its address during registration — so WIRESERVE_NET_V4_CIDR and
# WIRESERVE_NET_V6_PREFIX have no effect here.

# Which agent instance a command acts on (same as --instance). Leave it
# unset here: this file is shared by every instance's unit. Per-instance
# settings go in /etc/wireserve/agent-<name>.env, which the
# wireserve-agent@<name> unit reads after this one.
# WIRESERVE_INSTANCE=default

# Where state and sockets live. Named instances use
# $WIRESERVE_STATE_ROOT/instances/<name>/ and $WIRESERVE_RUN_ROOT/wireserve-<name>/.
# WIRESERVE_STATE_ROOT=/var/lib/wireserve
# WIRESERVE_RUN_ROOT=/run
# Exact paths for the default instance only (older settings, still honoured):
# WIRESERVE_STATE_PATH=/var/lib/wireserve/agent-state.json
# WIRESERVE_SOCKET_PATH=/run/wireserve/agent.sock
# Shared by all instances; each rewrites only its own marked block.
# WIRESERVE_HOSTS_PATH=/etc/hosts

# Log level. The agent defaults to `info`, which reports each poll cycle.
# Set `warn` for a quieter log that still surfaces refused directory
# entries and failing polls.
# RUST_LOG=info
