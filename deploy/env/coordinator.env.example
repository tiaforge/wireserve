# WireServe coordinator configuration.
#
# Install at /etc/wireserve/coordinator.env, owned by the wireserve user,
# mode 600. Both the systemd unit and the Quadlet unit read this file if
# present (it's entirely optional — see below), and the container image
# ships the same values as image defaults, which anything here overrides.

# ---- Nothing below is required ----
#
# The admin token and both mesh ranges are auto-generated on first start
# if you leave them unset here, and persisted (mode 600) next to the
# database at <state dir>/coordinator-secrets.env — the coordinator's
# startup log names the exact path. That file is the source of truth from
# then on across restarts; an explicit environment variable of the same
# name (set here, or any other way) always takes precedence over it, for
# operators who'd rather manage one of these themselves. If you're
# starting fresh, you can skip straight to "Point a reverse proxy at
# WIRESERVE_LISTEN_ADDR" in the README and never touch this file at all.

# The single static admin secret (spec §4.0). Leave unset to have one
# generated for you, or set your own out of band:
#   openssl rand -hex 32
# WIRESERVE_ADMIN_TOKEN=

# Where the SQLite database lives. Defaults to
# $STATE_DIRECTORY/coordinator.db under the shipped systemd unit (systemd
# sets $STATE_DIRECTORY automatically for any unit using StateDirectory=,
# which this one does), or the relative path `wireserve.db` outside of
# systemd. Set explicitly if you want it somewhere else.
# WIRESERVE_DB_PATH=/var/lib/wireserve/coordinator.db

# ---- Mesh addressing ----
#
# Leave both unset to have a private, non-colliding pair generated for you
# on first start (see above). If you'd rather pick your own, set BOTH
# before the first node registers: addresses are allocated once and kept
# for the life of the node record (a rejoin deliberately reuses the same
# ones, spec §4.5), so changing either value later only affects nodes that
# have not registered yet, and leaves you with a mesh addressed out of two
# different ranges.

# IPv4 mesh range. Avoid anything inside 100.64.0.0/10, the
# carrier-grade-NAT block Tailscale allocates all of its addresses from
# and some ISPs use on WAN links — a host running such an overlay routes
# that entire /10 to the overlay's own interface, which covers mesh
# addresses in that range too. The coordinator warns at startup if the
# configured range overlaps; the auto-generated default never does.
# WIRESERVE_NET_V4_CIDR=10.90.0.0/24

# IPv6 mesh prefix. RFC 4193 requires the 40 bits after fd to be a
# pseudo-randomly generated Global ID, precisely so that two networks
# built independently can be merged without renumbering — a hand-picked
# round prefix like fd00:90::/64 has an all-but-zero Global ID, which
# collides with exactly the kind of neighbour it was supposed to be safe
# against (a Docker bridge configured with an fd00:: pool, another VPN, a
# router handing out a round-numbered ULA). If you want your own rather
# than the generated one:
#
#   python3 -c "import secrets;h=secrets.token_bytes(5).hex();print(f'fd{h[0:2]}:{h[2:6]}:{h[6:10]}::/64')"
#
# Note this is unrelated to Tailscale, whose own IPv6 range is
# fd7a:115c:a1e0::/48 and does not overlap either value.
# WIRESERVE_NET_V6_PREFIX=fdb4:d481:7c21::/64

# ---- Optional, shown with their defaults ----

# WIRESERVE_LISTEN_ADDR=0.0.0.0:47820
# WIRESERVE_ADMIN_LISTEN_ADDR=127.0.0.1:47821
# Log level. The coordinator defaults to `info`, which is what spec §7's
# audit log needs: node creation, registration, revoke, rejoin and service
# declare/withdraw are all emitted at that level. Raising this above `info`
# switches the audit log off.
# RUST_LOG=info

# How long a freshly-issued join token stays redeemable, in seconds.
# 0 disables expiry. A join token covers the gap between creating a node
# record and running `wireserve-agent join` on the machine — a
# minutes-long errand — but travels out of band through chat, password
# managers and terminal scrollback, where a credential outlives its
# usefulness by months. `wireserve-admin rejoin <name>` mints a fresh
# token whenever the window is missed, so a short default costs one extra
# command; no expiry at all costs a live credential nobody remembers
# issuing. Override per token with `create-node --ttl <secs>`.
# WIRESERVE_JOIN_TOKEN_TTL_SECS=1800

# Require an admin to approve a service declaration before any other node
# sees it. ON by default.
#
# Service names are globally unique and first-come-first-served, so with
# this off any node holding a valid bearer token can claim an unclaimed
# name -- or re-claim one freed a moment earlier when its owner was
# revoked -- and every other node's /etc/hosts will point <name>.wg at
# it. One compromised node is enough.
#
# Set to false for a single-operator mesh where every node is already
# trusted and the approval round trip is pure ceremony. With it off a
# declaration is written approved on arrival and nothing downstream can
# tell the feature exists.
#
# Note for an EXISTING deployment: turning this on (or upgrading into the
# default) grandfathers every service already declared, rather than
# blanking every node's hosts file. Use `wireserve-admin deny-service` to
# push a specific name back through review.
# WIRESERVE_REQUIRE_SERVICE_APPROVAL=true

# WIRESERVE_ONLINE_THRESHOLD_SECS=180
# Failed authentications across ALL sources, per window, before failure
# responses start being delayed (250ms, rising to a 1s cap). This, not
# WIRESERVE_RATE_LIMIT_MAX below, is the actual bound on how fast a
# stranger may guess: the per-source window only selects the response
# code, because behind a reverse proxy every node shares one source
# address and rejecting on it would take the whole mesh offline.
#
# A valid credential is never delayed, so a legitimate node sharing an
# address with whoever is guessing is unaffected.
# WIRESERVE_GLOBAL_AUTH_FAILURE_MAX=20
# WIRESERVE_GLOBAL_AUTH_FAILURE_WINDOW_SECS=60

# Every failed authentication is also logged as
# `event="auth_failure"` with the resolved client address, for a
# fail2ban-style jail on the PROXY host -- which, unlike the coordinator,
# can see the real client and holds the privilege to block it. See
# deploy/fail2ban/. Note the logged address is only the real client when
# WIRESERVE_TRUST_PROXY_HEADERS is on.

# WIRESERVE_RATE_LIMIT_MAX=10
# WIRESERVE_RATE_LIMIT_WINDOW_SECS=60

# Resolve the client address from the right-most X-Forwarded-For entry
# instead of the raw TCP peer. Turn this on when — and only when — the
# node-facing listener is reachable exclusively through a reverse proxy
# that sets the header. With a directly reachable listener it lets any
# client forge its own source address and evade rate limiting entirely.
# WIRESERVE_TRUST_PROXY_HEADERS=false
