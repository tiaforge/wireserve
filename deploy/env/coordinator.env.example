# WireServe coordinator configuration.
#
# Install at /etc/wireserve/coordinator.env, owned by the wireserve user,
# mode 600 — it holds the admin token. Both the systemd unit and the
# Quadlet unit read this file; the container image ships the same values
# as image defaults, which anything here overrides.

# ---- Required ----

# The single static admin secret (spec §4.0). Generate once, out of band:
#   openssl rand -hex 32
# The coordinator refuses to start without it.
WIRESERVE_ADMIN_TOKEN=CHANGE-ME

# ---- Mesh addressing ----
#
# Set BOTH of these before the first node registers. Addresses are
# allocated once and then kept for the life of the node record (a rejoin
# deliberately reuses the same ones, spec §4.5), so changing either value
# later only affects nodes that have not registered yet, and leaves you
# with a mesh addressed out of two different ranges.

# IPv4 mesh range. Deliberately NOT the code default of 100.90.0.0/24:
# that sits inside 100.64.0.0/10, the carrier-grade-NAT block Tailscale
# allocates all of its addresses from and some ISPs use on WAN links. A
# host running such an overlay routes that entire /10 to the overlay's
# own interface, which covers these mesh addresses too. The coordinator
# warns at startup if the configured range overlaps.
WIRESERVE_NET_V4_CIDR=10.90.0.0/24

# IPv6 mesh prefix. Also not the code default of fd00:90::/64, for a
# different reason: RFC 4193 requires the 40 bits after fd to be a
# pseudo-randomly generated Global ID, precisely so that two networks
# built independently can be merged without renumbering. fd00:90:: has an
# all-but-zero Global ID, which makes it one of the most commonly
# hand-picked ULA prefixes there is — so it collides with exactly the
# kind of neighbour it was supposed to be safe against (a Docker bridge
# configured with an fd00:: pool, another VPN, a router handing out a
# round-numbered ULA). This value was generated randomly for this
# deployment. Generate your own rather than copying it:
#
#   python3 -c "import secrets;h=secrets.token_bytes(5).hex();print(f'fd{h[0:2]}:{h[2:6]}:{h[6:10]}::/64')"
#
# Note this is unrelated to Tailscale, whose own IPv6 range is
# fd7a:115c:a1e0::/48 and does not overlap either value.
WIRESERVE_NET_V6_PREFIX=fdb4:d481:7c21::/64

# ---- Optional, shown with their defaults ----

# WIRESERVE_LISTEN_ADDR=0.0.0.0:8080
# WIRESERVE_ADMIN_LISTEN_ADDR=127.0.0.1:8081
# WIRESERVE_DB_PATH=/var/lib/wireserve/coordinator.db
# Log level. The coordinator defaults to `info`, which is what spec §7's
# audit log needs: node creation, registration, revoke, rejoin and service
# declare/withdraw are all emitted at that level. Raising this above `info`
# switches the audit log off.
# RUST_LOG=info

# WIRESERVE_ONLINE_THRESHOLD_SECS=180
# WIRESERVE_RATE_LIMIT_MAX=10
# WIRESERVE_RATE_LIMIT_WINDOW_SECS=60

# Resolve the client address from the right-most X-Forwarded-For entry
# instead of the raw TCP peer. Turn this on when — and only when — the
# node-facing listener is reachable exclusively through a reverse proxy
# that sets the header. With a directly reachable listener it lets any
# client forge its own source address and evade rate limiting entirely.
# WIRESERVE_TRUST_PROXY_HEADERS=false
