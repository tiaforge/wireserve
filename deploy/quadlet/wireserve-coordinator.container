# Podman Quadlet unit. Install at
# /etc/containers/systemd/wireserve-coordinator.container (root) or
# ~/.config/containers/systemd/ (rootless), then `systemctl daemon-reload`
# and `systemctl start wireserve-coordinator`.
#
# Mirrors deploy/docker/coordinator.Dockerfile's image and capability set
# exactly (none — the coordinator never touches WireGuard or the host
# firewall, spec §8) and deploy/systemd/wireserve-coordinator.service's
# env/volume shape. Written by hand against both, not generated, so any
# future change to either must be applied here too.

[Unit]
Description=WireServe coordinator (Podman Quadlet)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/wireserve-coordinator:latest
# Start from deploy/env/coordinator.env.example — it documents every
# setting, including the mesh ranges (WIRESERVE_NET_V4_CIDR /
# WIRESERVE_NET_V6_PREFIX) that must be right before the first node
# registers.
EnvironmentFile=/etc/wireserve/coordinator.env
# Node-facing port: publish per your reverse-proxy topology (often not
# published to the host at all — see the Dockerfile's own comments and
# PLAN.md decisions log #24 — a private Docker/Podman network reaching it
# by container name is the common case).
PublishPort=127.0.0.1:8080:8080
# The admin port is deliberately not published at all. It binds loopback
# INSIDE the container (spec §4.0: never 0.0.0.0), so a PublishPort for
# it would forward to a port nothing listens on. Reach it with
# `podman exec <container> wireserve-admin ...`, which runs inside the
# container's own network namespace.
Volume=wireserve-coordinator-data:/var/lib/wireserve

[Service]
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target default.target
