[Unit]
Description=WireServe agent
Documentation=file:///usr/share/doc/wireserve/wireserve-design-spec.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Secrets and per-deployment config (WIRESERVE_STATE_PATH override, poll
# interval, etc. — the bearer token and WireGuard private key themselves
# are never put here, they live in the mode-600 state file the agent
# manages itself, see PLAN.md decisions log).
EnvironmentFile=-/etc/wireserve/agent.env

ExecStartPre=/usr/bin/install -d -m 0700 /run/wireserve
# Legacy iptables serialises through this lock file; it must exist before
# the sandbox below is set up for ReadWritePaths to grant it (the `+` runs
# this one step outside the sandbox). Harmless where nothing uses it.
ExecStartPre=+/bin/sh -c 'test -e /run/xtables.lock || : > /run/xtables.lock'
ExecStart=/usr/local/bin/wireserve daemon
Restart=on-failure
RestartSec=2s
# A dead agent leaves the last-applied nftables state exactly as
# restricted as it was (spec §5) — restarting quickly is the mitigation
# for stale-but-safe state, not a defense against it. It's still safe to
# restart aggressively, since teardown()-then-deny-all runs again before
# the first real apply() on every startup (spec §5's ordering
# requirement), so a crash loop never leaves the interface permissive.

RuntimeDirectory=wireserve wireserve-tls
RuntimeDirectoryMode=0700
# The directory starts out root-only. When a `wireserve` group exists the
# daemon hands it, and its IPC socket, to that group (0750/0660) so its
# members can run `wireserve serve`/`list`/... without sudo. Changing a
# file's group to one root is not itself a member of needs CAP_CHOWN,
# hence it in the bounding set below.
# The second directory holds the TLS terminator's socket (PLAN.md M33),
# handed to the `wireserve-tls` group the same way.
StateDirectory=wireserve
StateDirectoryMode=0700

# Runs as root, not a hardened non-root user — deliberately, and unlike
# the coordinator's unit. Spec §8 asks for CAP_NET_ADMIN + /dev/net/tun
# "not full root where avoidable," but avoiding full root here would
# still require CAP_DAC_OVERRIDE (or an /etc/hosts ACL) to let the agent
# write the managed hosts-file block as a non-root user (spec §6: "no new
# privilege required — the agent already runs with the elevation needed
# to manage the WireGuard interface," which in practice means running as
# root, since CAP_NET_ADMIN alone doesn't grant /etc/hosts write access).
# CAP_DAC_OVERRIDE is broad enough that pretending it's meaningfully
# safer than root would be dishonest, so the bounding set below is
# informational (documents exactly which capabilities the workload
# needs) rather than a real privilege reduction.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE CAP_CHOWN
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
DeviceAllow=/dev/net/tun rw
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
# Everything read-only except the paths the agent actually writes (plus
# /run/xtables.lock, shared with ufw/iptables for host-firewall interop),
# and the hosts file is granted as a single file rather than the whole of
# /etc. That is only possible because `fsutil::atomic_write` falls back to
# an in-place write when the *directory* refuses the temp file: with /etc
# read-only the temp-file create fails with EROFS before any rename is
# attempted, and the bind-mounted /etc/hosts stays writable on its own.
# Before that fallback existed this line had to read `/etc`, which made
# this unit meaningfully looser than the coordinator's for no benefit.
# A single-file grant is a bind mount, and the kernel drops it when
# anything on the host replaces /etc/hosts by rename (sed -i, an editor);
# the agent then finds the file read-only and exits so Restart= below
# re-creates the mount (PLAN.md decisions log #79).
ProtectSystem=strict
ReadWritePaths=/var/lib/wireserve /run/wireserve /run/wireserve-tls /etc/hosts -/run/xtables.lock

[Install]
WantedBy=multi-user.target
