# A named agent instance: `systemctl enable --now wireserve-agent@work`
# runs `wireserve --instance work daemon`. One per extra mesh (or
# extra identity) on this host, next to the plain wireserve-agent.service,
# which runs the default instance. Join each instance first:
#
#   sudo wireserve --instance work join <coordinator-url> -
#
# Each instance has its own state (/var/lib/wireserve/instances/<name>),
# socket (/run/wireserve-<name>), WireGuard interface (the first free of
# wireserve0..wireserve15, kept across restarts), listen port, firewall
# tables and hosts-file block. Everything else about the sandbox is the
# same as wireserve-agent.service — see the comments there; keep the two
# in step.

[Unit]
Description=WireServe agent (instance %i)
Documentation=file:///usr/share/doc/wireserve/wireserve-design-spec.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Shared settings first, then this instance's own (e.g. RUST_LOG).
EnvironmentFile=-/etc/wireserve/agent.env
EnvironmentFile=-/etc/wireserve/agent-%i.env

ExecStartPre=+/bin/sh -c 'test -e /run/xtables.lock || : > /run/xtables.lock'
ExecStart=/usr/local/bin/wireserve --instance %i daemon
Restart=on-failure
RestartSec=2s

# A sibling of /run/wireserve rather than inside it: systemd removes a
# unit's RuntimeDirectory when the unit stops, so nesting would let the
# default instance's stop delete this one's socket.
RuntimeDirectory=wireserve-%i
RuntimeDirectoryMode=0700
# The directory starts out root-only. When a `wireserve` group exists the
# daemon hands it, and its IPC socket, to that group (0750/0660) so its
# members can run `wireserve serve`/`list`/... without sudo. Changing a
# file's group to one root is not itself a member of needs CAP_CHOWN,
# hence it in the bounding set below.
StateDirectory=wireserve/instances/%i
StateDirectoryMode=0700

CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE CAP_CHOWN
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
DeviceAllow=/dev/net/tun rw
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
# Read-only everywhere else, including the other instances' state, which
# this one only reads (to leave their interface names and ports alone).
# /etc/hosts as a single file: see wireserve-agent.service for why that
# works, and what happens when the host replaces the file.
ProtectSystem=strict
ReadWritePaths=/var/lib/wireserve/instances/%i /run/wireserve-%i /etc/hosts -/run/xtables.lock -/etc/caddy

[Install]
WantedBy=multi-user.target
