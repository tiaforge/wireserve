# The TLS terminator (PLAN.md M33): serves this node's services published
# on TCP 443 with HTTPS, each on its own service address, with a
# certificate it gets itself (the coordinator publishes the DNS-01
# challenge record for it). `wireserve install` installs and enables it
# beside wireserve-agent.service.
#
# Its own user and a tight sandbox, on purpose: it parses TLS and HTTP from
# the whole mesh, and none of that belongs in the root daemon that holds
# the WireGuard key and edits the firewall. It talks to the agent over
# /run/wireserve-tls/tls.sock, which answers nothing but a check-in and a
# challenge request. It holds no privilege at all: it listens on the socket
# wireserve-tls.socket keeps for it on an unprivileged port (PLAN.md M35),
# to which the agent rewrites the service addresses' 443.
#
# PartOf: it stops and restarts with the agent, whose socket it needs. The
# listening socket stays with systemd meanwhile.

[Unit]
Description=wireserve TLS terminator
Documentation=file:///usr/share/doc/wireserve/wireserve-design-spec.md
Requires=wireserve-tls.socket
After=wireserve-tls.socket wireserve-agent.service
PartOf=wireserve-agent.service

[Service]
Type=simple
User=wireserve-tls
Group=wireserve-tls
EnvironmentFile=-/etc/wireserve/tls.env
ExecStart=/usr/local/bin/wireserve tls-daemon
Restart=on-failure
RestartSec=5s

# Certificates, their keys and the ACME account key. Its own, 0700.
StateDirectory=wireserve-tls
StateDirectoryMode=0700

# Sockets (`serve::Limits`): up to 4096 open connections, on 443 and 80
# together; up to 8192 requests being served at once, each holding at most
# one connection to its backend until its answer is sent — a WebSocket for
# as long as it is open — whatever the client does, since over HTTP/2 one
# connection carries up to 100 of them; and up to 1024 idle backend
# connections kept for the next request. 4096 + 8192 + 1024 = 13312, which
# leaves 3072 for the listeners, the link to the agent, the sign-in's and
# ACME's own connections and the runtime. One address gets 128 connections
# and 256 requests of those, a forwarding node 1024 and 2048. Above
# systemd's default 1024, which the caps would otherwise never get to.
LimitNOFILE=16384

CapabilityBoundingSet=
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=wireserve-agent.service
