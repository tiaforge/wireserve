# The TLS terminator for a named agent instance: `wireserve-tls@work` runs
# `wireserve --instance work tls-daemon` beside `wireserve-agent@work`. See
# wireserve-tls.service for what it is and why it is sandboxed this way;
# keep the two in step.

[Unit]
Description=wireserve TLS terminator (instance %i)
Documentation=file:///usr/share/doc/wireserve/wireserve-design-spec.md
Requires=wireserve-tls@%i.socket
After=wireserve-tls@%i.socket wireserve-agent@%i.service
PartOf=wireserve-agent@%i.service

[Service]
Type=simple
User=wireserve-tls
Group=wireserve-tls
EnvironmentFile=-/etc/wireserve/tls.env
EnvironmentFile=-/etc/wireserve/tls-%i.env
ExecStart=/usr/local/bin/wireserve --instance %i tls-daemon
Restart=on-failure
RestartSec=5s

StateDirectory=wireserve-tls/%i
StateDirectoryMode=0700

# Sockets (`serve::Limits`): up to 4096 open connections, on 443 and 80
# together; up to 8192 requests being served at once, each holding at most
# one connection to its backend until its answer is sent — a WebSocket for
# as long as it is open — whatever the client does, since over HTTP/2 one
# connection carries up to 100 of them; and up to 1024 idle backend
# connections kept for the next request. 4096 + 8192 + 1024 = 13312, which
# leaves 3072 for the listeners, the link to the agent, the sign-in's and
# ACME's own connections and the runtime. One address gets 128 connections
# and 256 requests of those, a forwarding node 1024 and 2048. Above
# systemd's default 1024, which the caps would otherwise never get to.
LimitNOFILE=16384

CapabilityBoundingSet=
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=wireserve-agent@%i.service
