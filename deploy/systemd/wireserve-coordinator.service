[Unit]
Description=WireServe coordinator
Documentation=file:///usr/share/doc/wireserve/wireserve-design-spec.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wireserve
Group=wireserve

# Secrets and per-deployment config (WIRESERVE_ADMIN_TOKEN,
# WIRESERVE_LISTEN_ADDR, WIRESERVE_ADMIN_LISTEN_ADDR, WIRESERVE_DB_PATH,
# WIRESERVE_NET_V4_CIDR, WIRESERVE_NET_V6_PREFIX, ...) live outside the
# unit file, mode 600, owned by the wireserve user. This file is entirely
# optional (note the leading `-`): the admin token and both mesh ranges
# are auto-generated and persisted on first start if left unset, and
# WIRESERVE_DB_PATH resolves against $STATE_DIRECTORY (which
# StateDirectory= below causes systemd to set automatically) with no
# configuration at all. Start from deploy/env/coordinator.env.example if
# you want to override any of that.
#
# Deliberately NOT duplicated as Environment= lines here: systemd applies
# these in file order, so an Environment= line placed after
# EnvironmentFile= wins, and the operator's edit to their own env file is
# silently ignored. This unit used to set WIRESERVE_DB_PATH that way while
# coordinator.env.example documented it as settable -- the exact trap this
# comment warns about, sprung two lines below it. There is now no
# Environment= line here at all; every setting comes from the env file,
# which carries the same default.
#
# Set WIRESERVE_TRUST_PROXY_HEADERS=true there when (and only when) the
# node-facing listener is reachable exclusively through a reverse proxy
# that sets X-Forwarded-For: it makes rate limiting and /register's
# endpoint fallback use the real client address instead of the proxy's.
# Leaving it on with a directly reachable listener lets clients forge
# their own source address.
#
# WIRESERVE_LISTEN_ADDR's port number also carries a self-hosted UDP
# reflexive-address responder (NAT-traversal step 2, PLAN.md decisions
# log #90+) — no capability change needed here (RestrictAddressFamilies=
# below already permits AF_INET/AF_INET6 UDP sockets), but unlike the
# HTTP side, that port needs its own direct UDP forward at your
# firewall/router, since a reverse proxy only ever forwards HTTP.
EnvironmentFile=-/etc/wireserve/coordinator.env

# One-time move from the directory this unit used to share with the agent
# (/var/lib/wireserve) to its own (security review finding #6): systemd
# recursively chowns a StateDirectory= to the unit's User= whenever the
# owner doesn't match, so while both units named the same directory,
# starting this one handed the agent's WireGuard private key and bearer
# token to the unprivileged `wireserve` user. Runs as root (`+`) because
# the old directory may be root-owned by then; does nothing once the new
# directory has a database, when there is nothing to move, or when
# WIRESERVE_DB_PATH is set explicitly (that database is left where the
# operator put it). A symlink among the files is never moved or followed:
# it fails the start instead, since moving the rest would leave the
# database next to a freshly generated admin token and mesh ranges.
ExecStartPre=+/bin/sh -c '\
    old=/var/lib/wireserve; new=/var/lib/wireserve-coordinator; \
    files="coordinator.db coordinator.db-wal coordinator.db-shm coordinator-secrets.env"; \
    [ -e "$$new/coordinator.db" ] && exit 0; \
    grep -qs "^[[:space:]]*WIRESERVE_DB_PATH=" /etc/wireserve/coordinator.env && exit 0; \
    [ -e "$$old/coordinator.db" ] || [ -L "$$old/coordinator.db" ] || exit 0; \
    for f in $$files; do \
        if [ -L "$$old/$$f" ] || { [ -e "$$old/$$f" ] && [ ! -f "$$old/$$f" ]; }; then \
            echo "refusing to move $$old/$$f: not a regular file" >&2; exit 1; \
        fi; \
    done; \
    for f in $$files; do \
        if [ -f "$$old/$$f" ]; then \
            mv "$$old/$$f" "$$new/$$f" && [ ! -L "$$new/$$f" ] && chmod 600 "$$new/$$f" \
                && chown -h wireserve:wireserve "$$new/$$f" || exit 1; \
        fi; \
    done; \
    echo "moved the coordinator database from $$old to $$new"'

ExecStart=/usr/local/bin/wireserve-coordinator
Restart=on-failure
RestartSec=2s

# The coordinator never touches WireGuard or the host firewall — it is a
# plain HTTP API and needs no special capabilities (spec §8).
#
# Its own directory, never the agent's /var/lib/wireserve: see the
# ExecStartPre= above for what sharing one did.
StateDirectory=wireserve-coordinator
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wireserve-coordinator
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryDenyWriteExecute=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
