[Unit]
Description=wireserve coordinator
Documentation=file:///usr/share/doc/wireserve/wireserve-design-spec.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Its own user, never `wireserve`: on a host that also runs an agent,
# `wireserve` is the group allowed to drive the root agent daemon over its
# socket (PLAN.md M30), and a coordinator running in it could do the same.
# `wireserve-coordinator install` creates this user; by hand:
#   sudo useradd --system --user-group --no-create-home --shell /usr/sbin/nologin wireserve-coordinator
# A different user goes in a drop-in (`install --user` writes one), so
# this file stays exactly what ships.
User=wireserve-coordinator
Group=wireserve-coordinator

# Secrets and per-deployment config (WIRESERVE_ADMIN_TOKEN,
# WIRESERVE_LISTEN_ADDR, WIRESERVE_ADMIN_LISTEN_ADDR, WIRESERVE_DB_PATH,
# WIRESERVE_NET_V4_CIDR, WIRESERVE_NET_V6_PREFIX, ...) live outside the
# unit file, mode 600, owned by root (systemd reads it before dropping
# privileges). `wireserve-coordinator install` writes it from a few
# questions. This file is entirely
# optional (note the leading `-`): the admin token and both mesh ranges
# are auto-generated and persisted on first start if left unset, and
# WIRESERVE_DB_PATH resolves against $STATE_DIRECTORY (which
# StateDirectory= below causes systemd to set automatically) with no
# configuration at all. Start from deploy/env/coordinator.env.example if
# you want to override any of that.
#
# Deliberately NOT duplicated as Environment= lines here: systemd applies
# these in file order, so an Environment= line placed after
# EnvironmentFile= wins, and the operator's edit to their own env file is
# silently ignored. There is no Environment= line here at all; every
# setting comes from the env file.
#
# Set WIRESERVE_TRUST_PROXY_HEADERS=true there when (and only when) the
# node-facing listener is reachable exclusively through a reverse proxy
# that sets X-Forwarded-For: it makes rate limiting and /register's
# endpoint fallback use the real client address instead of the proxy's.
# Leaving it on with a directly reachable listener lets clients forge
# their own source address.
#
# WIRESERVE_LISTEN_ADDR's port number also carries a self-hosted UDP
# reflexive-address responder (NAT-traversal step 2, PLAN.md decisions
# log #90+) — no capability change needed here (RestrictAddressFamilies=
# below already permits AF_INET/AF_INET6 UDP sockets), but unlike the
# HTTP side, that port needs its own direct UDP forward at your
# firewall/router, since a reverse proxy only ever forwards HTTP.
EnvironmentFile=-/etc/wireserve/coordinator.env

ExecStart=/usr/local/bin/wireserve-coordinator
Restart=on-failure
RestartSec=2s

# The coordinator never touches WireGuard or the host firewall — it is a
# plain HTTP API and needs no special capabilities (spec §8).
#
# Its own directory, never the agent's /var/lib/wireserve: systemd chowns a
# StateDirectory= to the unit's User=, so a shared one would hand the
# agent's WireGuard key to the unprivileged coordinator user (security
# review finding #6).
StateDirectory=wireserve-coordinator
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wireserve-coordinator
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryDenyWriteExecute=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
